<div class="publication-summary" aria-label="Publication overview / 成果概览">
  <div class="publication-summary__metric">
    <strong>6</strong>
    <span class="publication-summary__metric-label" data-language="en" lang="en">First / co-first / first student author</span>
    <span class="publication-summary__metric-label" data-language="zh" lang="zh-CN">一作 / 共同一作 / 学生一作</span>
    <span class="publication-summary__total">
      <span data-language="en" lang="en">7 accepted · 3 under review</span>
      <span data-language="zh" lang="zh-CN">7 篇已录用 · 3 篇在投</span>
    </span>
  </div>
  <div class="publication-overview-groups">
    {% for group in site.data.publication_overview %}
      <details class="publication-overview-group publication-overview-group--{{ group.id }}">
        <summary>
          <span>
            <span data-language="en" lang="en">{{ group.en }}</span>
            <span data-language="zh" lang="zh-CN">{{ group.zh }}</span>
          </span>
          <span class="publication-overview-count">{{ group.papers | size }}</span>
          <span class="publication-overview-chevron" aria-hidden="true"></span>
        </summary>
        <div class="publication-overview-body">
          {% for paper in group.papers %}
            <div class="publication-overview-entry">
              {% if paper.url %}
                {% if paper.url contains '://' %}
                  <a href="{{ paper.url }}" target="_blank" rel="noopener">{{ paper.name }}</a>
                {% else %}
                  <a href="{{ paper.url | relative_url }}">{{ paper.name }}</a>
                {% endif %}
              {% else %}
                <span>{{ paper.name }}</span>
              {% endif %}
              <span class="publication-overview-meta">
                {% if paper.venue != "" %}<span>{{ paper.venue }}</span>{% endif %}
                <span data-language="en" lang="en">{{ paper.role_en }}</span>
                <span data-language="zh" lang="zh-CN">{{ paper.role_zh }}</span>
              </span>
            </div>
          {% endfor %}
        </div>
      </details>
    {% endfor %}
  </div>
</div>
