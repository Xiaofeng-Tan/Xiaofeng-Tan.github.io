{% assign accepted_count = 0 %}
{% assign review_count = 0 %}
{% assign primary_count = 0 %}
{% assign spotlight_count = 0 %}
{% assign poster_count = 0 %}

{% for group in site.data.publication_overview %}
  {% if group.id == 'review' %}
    {% assign review_count = group.papers | size %}
  {% else %}
    {% assign group_count = group.papers | size %}
    {% assign accepted_count = accepted_count | plus: group_count %}
    {% for paper in group.papers %}
      {% if paper.role_en == 'First author' or paper.role_en == 'Co-first author' or paper.role_en == 'First student author' %}
        {% assign primary_count = primary_count | plus: 1 %}
      {% endif %}
      {% if paper.distinction == 'Spotlight' %}
        {% assign spotlight_count = spotlight_count | plus: 1 %}
      {% elsif paper.distinction == 'Poster' %}
        {% assign poster_count = poster_count | plus: 1 %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endfor %}

<div class="publication-summary" aria-label="Publication overview / 成果概览">
  <div class="publication-summary__headline">
    <span class="publication-summary__count" data-language="en" lang="en">{{ accepted_count }} accepted · {{ review_count }} under review</span>
    <span class="publication-summary__count" data-language="zh" lang="zh-CN">{{ accepted_count }} 篇已录用 · {{ review_count }} 篇在投</span>
    <span class="publication-summary__meta" data-language="en" lang="en">{{ spotlight_count }} Spotlight · {{ poster_count }} Posters · {{ primary_count }} first / co-first / first student-author papers</span>
    <span class="publication-summary__meta" data-language="zh" lang="zh-CN">Spotlight {{ spotlight_count }} 篇 · Poster {{ poster_count }} 篇 · {{ primary_count }} 篇为一作、共同一作或学生一作</span>
  </div>

  <div class="publication-summary__venues" aria-label="Accepted papers by venue / 已录用论文按发表场所统计">
    {% for group in site.data.publication_overview %}
      {% unless group.id == 'review' %}
        <span class="publication-summary__venue-item">
          <span class="publication-summary__venue-name">
            <span data-language="en" lang="en">{{ group.en }}</span>
            <span data-language="zh" lang="zh-CN">{{ group.zh }}</span>
          </span>
          <span class="publication-summary__venue-count">{{ group.papers | size }}</span>
        </span>
      {% endunless %}
    {% endfor %}
  </div>
</div>
